# Frontend environment. Copy to .env.local and fill in. Never commit real values.

# Address of the backend API, without a trailing slash. Leave empty to use the same origin (requests go through the BACKEND_URL rewrite).
NEXT_PUBLIC_API_URL=

# Where the app sends /api/v1 requests. Leave out to use the hosted backend; set to your own backend when developing.
BACKEND_URL=http://localhost:8080
