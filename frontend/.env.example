# Frontend environment. Copy to .env.local and fill in. Never commit real values.

# Address of the backend API, without a trailing slash. Leave empty to use the same origin (requests go through the BACKEND_URL rewrite). The sign-in cookie only reaches the API over the same-origin rewrite while COOKIE_SAME_SITE is None; set this to https://api.platelyy.com only once the backend has COOKIE_SAME_SITE=Lax and COOKIE_DOMAIN=.platelyy.com.
NEXT_PUBLIC_API_URL=

# Where the app sends /api/v1 requests. Leave out to use the hosted backend (the old Render address); set to https://api.platelyy.com when the API moves, or to your own backend when developing.
BACKEND_URL=http://localhost:8080

# The site's own address, without a trailing slash, for link previews and the home-screen icon (for example https://www.platelyy.com). Leave out on a laptop and it falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
