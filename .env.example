# Backend environment. Copy to .env and fill in real values. Never commit real values.

# PostgreSQL connection (JDBC URL, user, password).
DB_URL=jdbc:postgresql://localhost:5432/scan_to_order
DB_USERNAME=postgres
DB_PASSWORD=change-me
# Secret used to sign sign-in tokens: at least 32 characters.
JWT_SECRET=change-me-to-a-long-random-string-of-32-or-more-characters
# Token lifetime in milliseconds (86400000 is one day).
JWT_EXPIRATION=86400000
# Redis, used to cache the menu.
REDIS_HOST=localhost
REDIS_PORT=6379
# Paystack secret key (use a test key outside production).
PAYSTACK_SECRET_KEY=sk_test_replace_me
# Paystack API address.
PAYSTACK_BASE_URL=https://api.paystack.co
# Where Paystack sends the guest after paying.
PAYSTACK_CALLBACK_URL=http://localhost:3000/order-success
# Address of the web app: used in QR codes and in links inside emails.
FRONTEND_URL=http://localhost:3000
# "create" rebuilds the database on every start. Use "validate" or "update" once the data matters.
DDL_AUTO=create
# Password for the demo staff accounts the seeder creates.
SEED_MANAGER_PASSWORD=change-me
# Platform owner's sign-in, created by the seeder.
PLATFORM_ADMIN_USERNAME=platformadmin
PLATFORM_ADMIN_PASSWORD=change-me
# Outgoing email. Leave MAIL_HOST empty to keep emails in memory (read them as platform admin).
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@plately.local
# Plately's charge on each restaurant payment, as a percentage (placeholder until pricing is decided).
PLATELY_CHARGE_PERCENT=2.0
# Who pays Paystack's own fee: "account" (Plately) or "subaccount" (the restaurant).
PAYSTACK_FEE_BEARER=account
# What a planner pays Plately per expected guest, in kobo (50000 is 500 naira). A placeholder until pricing is decided.
EVENT_FEE_PER_GUEST_KOBO=50000
